<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    Options -Indexes

    # Block dotfiles (.env, .git, etc.) and sensitive configuration dumps
    RewriteRule ^\. - [F,L]
    RewriteRule (?i)\.(env|sql|zip|gz|tar|log|bak|swp|sh)$ - [F,L]

    # Route /assets/ requests to dist/assets/ directly if not in public/assets/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

    # Map legacy /qfunnel2/uploads to uploads directly
    RewriteRule ^qfunnel2/uploads/(.*)$ uploads/$1 [L,NC]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route all other requests to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>
