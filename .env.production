# =================================================================
# LeadCollector SaaS — Production Configuration for cPanel
# Copy this content into your .env file on cPanel
# =================================================================

APP_NAME="LeadCollector"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_DOMAIN=yourdomain.com
APP_KEY=base64:3f4e2b8a9c1d0e7f5a6b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f

# cPanel MySQL Database Credentials
# (Create via cPanel -> MySQL Database Wizard)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=yourcpaneluser_qfunnel
DB_USERNAME=yourcpaneluser_dbuser
DB_PASSWORD=YourDatabasePasswordHere

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAME_SITE=Lax
